generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model almacen {
  id                                                    BigInt             @id @default(autoincrement())
  codigo                                                String             @unique @db.VarChar(50)
  nombre                                                String             @db.VarChar(150)
  descripcion                                           String?
  activo                                                Boolean            @default(true)
  createdAt                                             DateTime           @default(now())
  updatedAt                                             DateTime
  producto_almacen                                      producto_almacen[]
  transferencia_transferencia_almacenDestinoIdToalmacen transferencia[]    @relation("transferencia_almacenDestinoIdToalmacen")
  transferencia_transferencia_almacenOrigenIdToalmacen  transferencia[]    @relation("transferencia_almacenOrigenIdToalmacen")
}

model categoria {
  id          BigInt     @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(50)
  nombre      String     @db.VarChar(150)
  descripcion String?
  activo      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  producto    producto[]
}

model historial_codigo_producto {
  id             BigInt   @id @default(autoincrement())
  productoId     BigInt
  codigoAnterior String   @db.VarChar(100)
  codigoNuevo    String   @db.VarChar(100)
  usuarioId      BigInt
  fechaCambio    DateTime @default(now())
  producto       producto @relation(fields: [productoId], references: [id])
  usuario        usuario  @relation(fields: [usuarioId], references: [id])

  @@index([fechaCambio])
  @@index([productoId])
  @@index([usuarioId])
}

model motivo_movimiento {
  id                    BigInt                  @id @default(autoincrement())
  tipoMovimientoId      BigInt
  codigo                String                  @db.VarChar(50)
  nombre                String                  @db.VarChar(150)
  signo                 Int
  requiereReferencia    Boolean                 @default(false)
  requiereObservacion   Boolean                 @default(false)
  activo                Boolean                 @default(true)
  tipo_movimiento       tipo_movimiento         @relation(fields: [tipoMovimientoId], references: [id])
  movimiento_inventario movimiento_inventario[]

  @@unique([id, tipoMovimientoId])
  @@unique([tipoMovimientoId, codigo])
  @@index([tipoMovimientoId])
}

model movimiento_inventario {
  id                     BigInt                 @id @default(autoincrement())
  productoAlmacenId      BigInt
  usuarioId              BigInt
  tipoMovimientoId       BigInt
  motivoMovimientoId     BigInt
  transferenciaDetalleId BigInt?
  cantidad               Decimal                @db.Decimal(18, 6)
  fechaOperacion         DateTime
  fechaRegistro          DateTime               @default(now())
  referencia             String?                @db.VarChar(150)
  observacion            String?
  productoCodigoSnapshot String                 @db.VarChar(100)
  productoNombreSnapshot String                 @db.VarChar(200)
  unidadCodigoSnapshot   String                 @db.VarChar(20)
  unidadNombreSnapshot   String                 @db.VarChar(100)
  createdAt              DateTime               @default(now())
  motivo_movimiento      motivo_movimiento      @relation(fields: [motivoMovimientoId, tipoMovimientoId], references: [id, tipoMovimientoId])
  producto_almacen       producto_almacen       @relation(fields: [productoAlmacenId], references: [id])
  tipo_movimiento        tipo_movimiento        @relation(fields: [tipoMovimientoId], references: [id])
  transferencia_detalle  transferencia_detalle? @relation(fields: [transferenciaDetalleId], references: [id])
  usuario                usuario                @relation(fields: [usuarioId], references: [id])

  @@index([fechaOperacion])
  @@index([motivoMovimientoId])
  @@index([productoAlmacenId, fechaOperacion])
  @@index([tipoMovimientoId])
  @@index([transferenciaDetalleId])
  @@index([usuarioId])
}

model permiso {
  id          BigInt        @id @default(autoincrement())
  clave       String        @unique @db.VarChar(100)
  nombre      String        @db.VarChar(150)
  descripcion String?
  activo      Boolean       @default(true)
  rol_permiso rol_permiso[]
}

model producto {
  id                        BigInt                      @id @default(autoincrement())
  codigo                    String                      @unique @db.VarChar(100)
  nombre                    String                      @db.VarChar(200)
  descripcion               String?
  categoriaId               BigInt
  unidadMedidaId            BigInt
  activo                    Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  historial_codigo_producto historial_codigo_producto[]
  categoria                 categoria                   @relation(fields: [categoriaId], references: [id])
  unidad_medida             unidad_medida               @relation(fields: [unidadMedidaId], references: [id])
  producto_almacen          producto_almacen[]
  transferencia_detalle     transferencia_detalle[]

  @@index([categoriaId])
  @@index([unidadMedidaId])
}

model producto_almacen {
  id                                                                                     BigInt                  @id @default(autoincrement())
  productoId                                                                             BigInt
  almacenId                                                                              BigInt
  stockActual                                                                            Decimal                 @default(0) @db.Decimal(18, 6)
  stockMinimo                                                                            Decimal                 @default(0) @db.Decimal(18, 6)
  activo                                                                                 Boolean                 @default(true)
  createdAt                                                                              DateTime                @default(now())
  updatedAt                                                                              DateTime
  movimiento_inventario                                                                  movimiento_inventario[]
  almacen                                                                                almacen                 @relation(fields: [almacenId], references: [id])
  producto                                                                               producto                @relation(fields: [productoId], references: [id])
  transferencia_detalle_transferencia_detalle_productoAlmacenDestinoIdToproducto_almacen transferencia_detalle[] @relation("transferencia_detalle_productoAlmacenDestinoIdToproducto_almacen")
  transferencia_detalle_transferencia_detalle_productoAlmacenOrigenIdToproducto_almacen  transferencia_detalle[] @relation("transferencia_detalle_productoAlmacenOrigenIdToproducto_almacen")

  @@unique([productoId, almacenId])
  @@index([almacenId])
  @@index([productoId])
}

model rol {
  id          BigInt        @id @default(autoincrement())
  nombre      String        @unique @db.VarChar(100)
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  rol_permiso rol_permiso[]
  usuario_rol usuario_rol[]
}

model rol_permiso {
  rolId     BigInt
  permisoId BigInt
  permiso   permiso @relation(fields: [permisoId], references: [id])
  rol       rol     @relation(fields: [rolId], references: [id])

  @@id([rolId, permisoId])
}

model tipo_movimiento {
  id                    BigInt                  @id @default(autoincrement())
  codigo                String                  @unique @db.VarChar(30)
  nombre                String                  @db.VarChar(100)
  activo                Boolean                 @default(true)
  motivo_movimiento     motivo_movimiento[]
  movimiento_inventario movimiento_inventario[]
}

model transferencia {
  id                                               BigInt                  @id @default(autoincrement())
  codigo                                           String                  @unique @db.VarChar(50)
  almacenOrigenId                                  BigInt
  almacenDestinoId                                 BigInt
  estado                                           String                  @db.VarChar(30)
  usuarioSolicitaId                                BigInt
  usuarioDespachaId                                BigInt?
  usuarioRecibeId                                  BigInt?
  fechaSolicitud                                   DateTime                @default(now())
  fechaDespacho                                    DateTime?
  fechaRecepcion                                   DateTime?
  observacion                                      String?
  createdAt                                        DateTime                @default(now())
  updatedAt                                        DateTime
  almacen_transferencia_almacenDestinoIdToalmacen  almacen                 @relation("transferencia_almacenDestinoIdToalmacen", fields: [almacenDestinoId], references: [id])
  almacen_transferencia_almacenOrigenIdToalmacen   almacen                 @relation("transferencia_almacenOrigenIdToalmacen", fields: [almacenOrigenId], references: [id])
  usuario_transferencia_usuarioDespachaIdTousuario usuario?                @relation("transferencia_usuarioDespachaIdTousuario", fields: [usuarioDespachaId], references: [id])
  usuario_transferencia_usuarioRecibeIdTousuario   usuario?                @relation("transferencia_usuarioRecibeIdTousuario", fields: [usuarioRecibeId], references: [id])
  usuario_transferencia_usuarioSolicitaIdTousuario usuario                 @relation("transferencia_usuarioSolicitaIdTousuario", fields: [usuarioSolicitaId], references: [id])
  transferencia_detalle                            transferencia_detalle[]

  @@index([almacenDestinoId])
  @@index([almacenOrigenId])
  @@index([estado])
  @@index([fechaSolicitud])
}

model transferencia_detalle {
  id                                                                                BigInt                  @id @default(autoincrement())
  transferenciaId                                                                   BigInt
  productoId                                                                        BigInt
  productoAlmacenOrigenId                                                           BigInt
  productoAlmacenDestinoId                                                          BigInt
  cantidad                                                                          Decimal                 @db.Decimal(18, 6)
  movimiento_inventario                                                             movimiento_inventario[]
  producto_almacen_transferencia_detalle_productoAlmacenDestinoIdToproducto_almacen producto_almacen        @relation("transferencia_detalle_productoAlmacenDestinoIdToproducto_almacen", fields: [productoAlmacenDestinoId], references: [id])
  producto_almacen_transferencia_detalle_productoAlmacenOrigenIdToproducto_almacen  producto_almacen        @relation("transferencia_detalle_productoAlmacenOrigenIdToproducto_almacen", fields: [productoAlmacenOrigenId], references: [id])
  producto                                                                          producto                @relation(fields: [productoId], references: [id])
  transferencia                                                                     transferencia           @relation(fields: [transferenciaId], references: [id])

  @@index([productoAlmacenDestinoId])
  @@index([productoAlmacenOrigenId])
  @@index([productoId])
  @@index([transferenciaId])
}

model unidad_medida {
  id                  BigInt     @id @default(autoincrement())
  codigo              String     @unique @db.VarChar(20)
  nombre              String     @db.VarChar(100)
  decimalesPermitidos Int        @default(0)
  activo              Boolean    @default(true)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime
  producto            producto[]
}

model usuario {
  id                                                     BigInt                      @id @default(autoincrement())
  nombre                                                 String                      @db.VarChar(150)
  email                                                  String                      @unique @db.VarChar(200)
  activo                                                 Boolean                     @default(true)
  createdAt                                              DateTime                    @default(now())
  updatedAt                                              DateTime
  historial_codigo_producto                              historial_codigo_producto[]
  movimiento_inventario                                  movimiento_inventario[]
  transferencia_transferencia_usuarioDespachaIdTousuario transferencia[]             @relation("transferencia_usuarioDespachaIdTousuario")
  transferencia_transferencia_usuarioRecibeIdTousuario   transferencia[]             @relation("transferencia_usuarioRecibeIdTousuario")
  transferencia_transferencia_usuarioSolicitaIdTousuario transferencia[]             @relation("transferencia_usuarioSolicitaIdTousuario")
  usuario_rol                                            usuario_rol[]
}

model usuario_rol {
  usuarioId BigInt
  rolId     BigInt
  rol       rol     @relation(fields: [rolId], references: [id])
  usuario   usuario @relation(fields: [usuarioId], references: [id])

  @@id([usuarioId, rolId])
}
